diff --git a/tests/components/huawei_lte/test_dhcp_switch.py b/tests/components/huawei_lte/test_dhcp_switch.py
new file mode 100644
index 0000000..ebfb6f9
--- /dev/null
+++ b/tests/components/huawei_lte/test_dhcp_switch.py
@@ -0,0 +1,89 @@
+"""Tests for the Huawei LTE DHCP switch."""
+
+from unittest.mock import MagicMock
+
+import pytest
+
+from homeassistant.components.huawei_lte.switch import HuaweiLteDhcpSwitch
+from homeassistant.exceptions import HomeAssistantError
+
+SETTINGS = {
+    "DhcpStatus": "0",
+    "DhcpIPAddress": "10.0.0.1",
+    "DhcpLanNetmask": "255.255.0.0",
+    "DhcpStartIPAddress": "10.0.1.10",
+    "DhcpEndIPAddress": "10.0.2.20",
+    "DhcpLeaseTime": "86400",
+    "DnsStatus": "0",
+    "PrimaryDns": "1.1.1.1",
+    "SecondaryDns": "8.8.8.8",
+    "accessipaddress": None,
+}
+
+
+def test_enable_preserves_settings() -> None:
+    """Send the complete retrieved configuration with only DHCP status changed."""
+    router = MagicMock()
+    changed = {**SETTINGS, "DhcpStatus": "1"}
+    router.client.dhcp.settings.side_effect = [SETTINGS.copy(), changed.copy()]
+    switch = HuaweiLteDhcpSwitch(router)
+    switch.schedule_update_ha_state = MagicMock()
+
+    switch._turn(True)
+
+    router.connection.post_set.assert_called_once_with("dhcp/settings", changed)
+    assert SETTINGS["DhcpStatus"] == "0"
+    assert switch.is_on
+
+
+def test_unchanged_avoids_write() -> None:
+    """Avoid writing when DHCP already has the requested state."""
+    router = MagicMock()
+    router.client.dhcp.settings.return_value = SETTINGS.copy()
+    switch = HuaweiLteDhcpSwitch(router)
+    switch.schedule_update_ha_state = MagicMock()
+
+    switch._turn(False)
+
+    router.connection.post_set.assert_not_called()
+    assert not switch.is_on
+
+
+def test_bad_response_does_not_write() -> None:
+    """Reject a response that does not contain a valid status."""
+    router = MagicMock()
+    router.client.dhcp.settings.return_value = {"DhcpStatus": "unexpected"}
+    switch = HuaweiLteDhcpSwitch(router)
+
+    with pytest.raises(HomeAssistantError):
+        switch._turn(True)
+
+    router.connection.post_set.assert_not_called()
+
+
+def test_failed_confirmation() -> None:
+    """Do not report success when the router did not apply the requested state."""
+    router = MagicMock()
+    router.client.dhcp.settings.return_value = SETTINGS.copy()
+    switch = HuaweiLteDhcpSwitch(router)
+    switch.schedule_update_ha_state = MagicMock()
+
+    with pytest.raises(HomeAssistantError):
+        switch._turn(True)
+
+    switch.schedule_update_ha_state.assert_not_called()
+
+
+def test_changed_dns_reports_error() -> None:
+    """Report a router changing DNS during the DHCP update."""
+    router = MagicMock()
+    changed = {**SETTINGS, "DhcpStatus": "1", "PrimaryDns": "9.9.9.9"}
+    router.client.dhcp.settings.side_effect = [SETTINGS.copy(), changed]
+    switch = HuaweiLteDhcpSwitch(router)
+    switch.schedule_update_ha_state = MagicMock()
+
+    with pytest.raises(HomeAssistantError, match="other DHCP or DNS settings"):
+        switch._turn(True)
+
+    assert switch.is_on
+    switch.schedule_update_ha_state.assert_called_once()
